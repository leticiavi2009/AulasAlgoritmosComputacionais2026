"""


from random import randint
row = int(input('Informe o número de linhas: '))
col = int(input('Informe o número de colunas: '))
dense = int(input('Informe a probabilidade de minas (inteiro de 0 a 100): '))
campo = []
for i in range(row):
    linha = []
    for j in range(col):
        mina = randint(1,100)
        if mina <= dense:
            linha.append('*')
        else:
            linha.append('.')
    campo.append(linha)
for i in campo:
    print(i)
for i in range(row):
    for j in range(col):
        cont = 0
        if campo[i][j] == '.':
            if i != 0:
                if campo[i-1][j] == '*':
                    cont += 1
            if i != 0 and j != col-1:
                if campo[i-1][j+1] == '*':
                    cont += 1
            if j != col-1:
                if campo[i][j+1] == '*':
                    cont += 1
            if i != row-1 and j != col-1:
                if campo[i+1][j+1] == '*':
                    cont += 1
            if i != row-1:
                if campo[i+1][j] == '*':
                    cont += 1
            if i != row-1 and j != 0:
                if campo[i+1][j-1] == '*':
                    cont += 1
            if j != 0:
                if campo[i][j-1] == '*':
                    cont += 1
            if i != 0 and j != 0:
                if campo[i-1][j-1] == '*':
                    cont += 1
            campo[i][j] = cont
for i in campo:
    for j in range(len(i)):
        if j != len(i)-1:
            print(i[j],end = ' ')
        else:
            print(i[j],end = '\n')
