while nome != 'fim': # faz o nome parar se o usuário digitar fim
    cpf = input('Entre com cpf: ') # coloca o valor de cpf
    idade = int(input('Entre com idade: ')) #insere o valor de idade
    agenda[cpf] = {'nome': nome, 'idade':idade} #faz cpf ser a chave primaria do bagui que insere os dados mais basicos mediane a POSIÇÃO CPF
    nome = input('Entre com o nome: ') #SÓ por ÚLTIMO que é digitado o nome, daí nao tem como inserir no dicionário o 'fim'. Na primeira vez, pega o nome de fora do dicionário
    
    
